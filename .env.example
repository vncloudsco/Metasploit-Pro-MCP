# Sao chép sang .env rồi chỉnh sửa: cp .env.example .env
# MỌI cấu hình nằm trong file .env.

# ---------- HTTP MCP Server ----------
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_PATH=/mcp

# Token client phải gửi: Authorization: Bearer <MCP_AUTH_TOKEN>
# Hãy thay bằng chuỗi ngẫu nhiên mạnh, ví dụ: openssl rand -hex 32
MCP_AUTH_TOKEN=replace-with-a-long-random-token

# ---------- Công tắc an toàn ----------
# true = cho phép exploit; false = từ chối exploit (mặc định)
EXPLOIT_ENABLED=false

# ---------- Metasploit Pro ----------
# https://localhost:3790 (nhìn từ trong container dùng host.docker.internal)
MSF_SCHEME=https
MSF_HOST=host.docker.internal
MSF_PORT=3790
MSF_API_KEY=replace-with-your-metasploit-pro-api-key
MSF_TLS_REJECT_UNAUTHORIZED=false

MSF_REST_BASE=/rest_api/v2
MSF_RPC_URI=/api/1.0
MSF_REQUEST_TIMEOUT_MS=30000
